  <category label="DaddyLive">
    <setting id="DLHD_enabled" type="bool" label="Enable integrated DaddyLive relay (restart Kodi after changing)" default="true" />
    <setting id="DLHD_auto_refresh" type="bool" label="Automatically regenerate DaddyLive M3U" default="true" />
    <setting id="DLHD_refresh_hours" type="number" label="DaddyLive M3U refresh interval (hours)" default="48" />
    <setting id="DLHD_epg" type="bool" label="Match USA/UK channels to EPGTalk combined guide" default="true" />
    <setting id="DLHD_base" type="text" label="Source website base URL" default="https://dlive.sx" />
    <setting id="DLHD_port" type="number" label="Local relay port (restart Kodi after changing)" default="8769" />
    <setting id="DLHD_automatic" type="bool" label="Automatically choose first working player" default="true" />
    <setting id="DLHD_player" type="enum" label="Manual player (when automatic selection is off)" values="Player 1|Player 2|Player 3|Player 4|Player 5|Player 6" default="0" />
    <setting id="DLHD_logos" type="bool" label="Look up online logos for channels missing from local bundle" default="true" />
    <setting id="DLHD_folder" type="folder" label="M3U output folder (blank uses Playlist Browser profile)" default="" />
    <setting id="DLHD_action_channels" type="action" label="Browse channels and IDs" action="ActivateWindow(Videos,plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=channels,return)" option="close" />
    <setting id="DLHD_action_export" type="action" label="Create / refresh M3U playlist" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=export)" option="close" />
    <setting id="DLHD_action_play" type="action" label="Test channel playback by ID" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=play)" option="close" />
    <setting id="DLHD_action_check" type="action" label="Check local relay" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=check)" option="close" />
    <setting id="DLHD_action_log" type="action" label="View DaddyLive debugging log" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=log)" option="close" />
    <setting id="DLHD_action_exportlog" type="action" label="Export DaddyLive debugging log" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=exportlog)" option="close" />
    <setting id="DLHD_action_epgreport" type="action" label="View EPG matching report" action="RunPlugin(plugin://plugin.video.playlistbrowser/?action=dlhd&amp;tool=epgreport)" option="close" />
  </category>
</settings>
