<?xml version="1.0" encoding="utf-8"?>
<settings>
  <category label="Start">
    <setting id="START_MODE" type="enum" label="On open, show:" default="0" values="Choose Source|First Source - Channels|First Source - Guide (Now)|First Source - Guide by Channel" />
  </category>
  <category label="Global Options">
    <setting id="REFRESH_EPG_ON_OPEN" type="bool" label="Refresh EPG when opening a source" default="false" />
    <setting id="EPG_TTL_HOURS" type="number" label="EPG cache hours" default="6" />
    <setting id="M3U_REFRESH_HOURS" type="number" label="Automatic playlist refresh hours (0 = off)" default="6" />
    <setting id="USE_LOGOS" type="bool" label="Use logos from M3U/EPG if available" default="true" />
    <setting id="USE_EPG_LOGO_FALLBACK" type="bool" label="Fallback to EPG channel icons when M3U has no logo" default="true" />
  </category>
  <category label="Source 1">
    <setting id="SRC1_NAME" type="text" label="Display name" default="Playlist 1" />
    <setting id="SRC1_M3U_URL" type="text" label="M3U URL or path" default="" />
    <setting id="SRC1_JSON_URL" type="text" label="JSON URL or path" default="" />
