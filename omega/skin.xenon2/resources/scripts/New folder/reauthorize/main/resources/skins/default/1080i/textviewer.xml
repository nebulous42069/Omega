<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>2001</defaultcontrol>
	<controls>

		<!-- Diffused splash background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>common/splash_bg.jpg</texture>
		</control>

		<!-- Dark overlay to keep text readable -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="BB0E0E0E">common/white.png</texture>
		</control>

		<control type="group">
			<left>280</left>
			<top>50</top>
			<control type="group">
				<width>1360</width>
				<control type="image">
					<height>980</height>
					<texture colordiffuse="FF383636">common/white.png</texture>
				</control>
				<control type="image">
					<height>100</height>
					<texture colordiffuse="silver">common/white.png</texture>
				</control>
				<control type="image">
					<left>8</left>
					<top>4</top>
					<width>90</width>
					<height>90</height>
					<align>left</align>
					<aligny>top</aligny>
					<aspectratio aligny="top">keep</aspectratio>
					<texture colordiffuse="FFCCCCCC">common/icon.png</texture>
				</control>
				<control type="label">
					<top>40</top>
					<left>105</left>
					<width max="1115">auto</width>
					<height>20</height>
					<font>font16</font>
					<textcolor>black</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[Window().Property(accountmgr.heading)]</label>
				</control>
				<control type="textbox" id="2000">
					<left>45</left>
					<top>114</top>
					<width>1265</width>
					<height>750</height>
					<onup>2000</onup>
					<ondown>2001</ondown>
					<scrolltime tween="sine">400</scrolltime>
					<font>font14</font>
					<textcolor>white</textcolor>
					<label>$INFO[Window().Property(accountmgr.text)]</label>
					<pagecontrol>2060</pagecontrol>
				</control>
				<control type="scrollbar" id="2060">
					<left>1320</left>
					<top>114</top>
					<width>30</width>
					<height>750</height>
					<texturesliderbackground border="15">scrollbars/scrollbaruni-bg.png</texturesliderbackground>
					<texturesliderbar border="15">scrollbars/scrollbaruni-bar.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="firebrick" border="15">scrollbars/scrollbaruni-bar-focus.png</texturesliderbarfocus>
					<textureslidernib>scrollbars/scrollbaruni-nib.png</textureslidernib>
					<textureslidernibfocus>scrollbars/scrollbaruni-nib.png</textureslidernibfocus>
					<onleft>2060</onleft>
					<onright>2060</onright>
					<onup>2060</onup>
					<ondown>2060</ondown>
					<showonepage>false</showonepage>
					<orientation>vertical</orientation>
				</control>
				<!-- Divider above close button -->
				<control type="image">
					<left>0</left>
					<top>870</top>
					<width>1360</width>
					<height>2</height>
					<texture colordiffuse="FF444444">common/white.png</texture>
				</control>
				<!-- Close button (id=2001) -->
				<control type="button" id="2001">
					<left>580</left>
					<top>878</top>
					<width>200</width>
					<height>52</height>
					<onup>2000</onup>
					<label>Close</label>
					<font>font14</font>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="FF555555">common/white.png</texturefocus>
					<texturenofocus colordiffuse="FF2A2A2A">common/white.png</texturenofocus>
					<align>center</align>
					<aligny>center</aligny>
				</control>
			</control>
		</control>
	</controls>
</window>