<settings>

	<!-- ═══════════════════════════════════════════════════════════
	     TAB 1 - READ ME FIRST
	═══════════════════════════════════════════════════════════ -->
	<category label="Read Me First">

		<!-- Filled in by settings_display at every Kodi start and before the settings open, so it
		     always names the version that is running, and whether it is the newest the start-up
		     check saw in the repo: "1.4.1  (latest)". Hidden until it has a value (1.4.1). -->
		<setting id="version.display" type="text" label="ReAuthorize version" default="" enable="false"
		         visible="!eq(0,)" />
		<setting type="action" label="Welcome &amp; How to Get Started" option="close"
		         action="RunScript(script.module.reauthorize, action=readMeFirst)" />
		<setting type="action" label="Already Signed In Inside Your Add-ons? Bring Those In" option="close"
		         action="RunScript(script.module.reauthorize, action=findSignins)" />
		<setting type="lsep" label="Work through the service tabs in this menu to authorize each service you have an account with." />

		<!-- Internal - not shown to user -->
		<setting id="checkAddonUpdates"    type="bool" label="" default="false"  visible="false" />
		<!-- The newest version the start-up check last saw in the repo -->
		<setting id="version.latest"       type="text" label="" default=""      visible="false" />
		<setting id="trakt.auto_push.consent" type="text" label="" default=""   visible="false" />
		<setting id="trakt.all_push.done"   type="text" label="" default=""   visible="false" />
		<!-- Fingerprints (hashes, never values) of sign-ins the user said "not now" to -->
		<setting id="import.declined"      type="text" label="" default=""      visible="false" />
		<!-- 'true' after this device found it was sharing its backup; startup asks once -->
		<setting id="server.shared.notice" type="text" label="" default=""      visible="false" />
		<!-- Written and read back at every start: proves Kodi can load and save this file (settings_health.py) -->
		<setting id="settings.probe"       type="text" label="" default=""      visible="false" />

	</category>

