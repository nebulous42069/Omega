  <include name="X2DVI_NormalButton">
        <include condition="String.IsEmpty(Skin.String(ButtonLAF))">X2DVI_ButtonClassic</include>
        <include condition="Skin.String(ButtonLAF,Modern)">X2DVI_ButtonModern</include>
        <include condition="Skin.String(ButtonLAF,Max)">X2DVI_ButtonMax</include>
        <texturenofocus border="5">MenuItemNF.png</texturenofocus>
