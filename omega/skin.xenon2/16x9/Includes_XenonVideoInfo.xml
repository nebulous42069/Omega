        </control>
    </include>
  <include name="X2DVI_StandardAutoScroll">
	    <autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
	</include>
  <include name="X2DVI_VideoCodecFlaggingConditions">
        <control type="image">
            <description>Video rez Image</description>
            <width>82</width>
            <height>52</height>
