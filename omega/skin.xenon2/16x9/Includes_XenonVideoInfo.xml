  <include name="X2DVI_SlowerAutoScroll">
	    <autoscroll time="4500" delay="16000" repeat="10000">true</autoscroll>
	</include>
  <include name="X2DVI_SpecialFeaturesFlaggingConditions">
        <control type="image">
            <description>Extra Info Flag</description>
            <width>82</width>
            <height>52</height>
            <aspectratio align="left">keep</aspectratio>
            <texture>$VAR[X2DVI_SpecialFeaturesInfoFlag]</texture>
