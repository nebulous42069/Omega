  <include name="X2EnhancedWidgetInfoPanel">
        <definition>
            <control type="group">
                <depth>DepthDialog+</depth>

                <!-- Only when setting is enabled -->
                <!-- Only when that widget list has focus -->
                <!-- Only for video widgets (movie / tvshow / episode / TMDbH items with a tmdb_id) -->
				<include>VisibleFadeEffect</include>

                <!-- Bottom half of the screen -->
                <left>0</left>
                <top>520</top>
                <!-- Bottom Widget 2 stays in place; show its information above the menu. -->
                <animation effect="slide" start="0,0" end="0,-520" time="0" condition="Skin.HasSetting(centermainmenu) + ControlGroup(90020).HasFocus">Conditional</animation>
                <width>1920</width>
                <height>570</height>

                <!-- Panel background -->
                <control type="image">
                    <visible>![Skin.HasSetting(centermainmenu) + ControlGroup(90020).HasFocus]</visible>
                    <left>-30</left>
                    <top>5</top>
                    <width>1975</width>
                    <height>560</height>
                    <texture border="5">colors/black.png</texture>
					<colordiffuse>D0000000</colordiffuse>
                <hitrect x="-10000" y="-10000" w="0" h="0"/></control>
                
				
				<control type="image">
                    <visible>Skin.HasSetting(centermainmenu) + ControlGroup(90020).HasFocus</visible>
                    <left>-30</left><top>0</top><width>1980</width><height>665</height>
                    <texture>colors/black.png</texture><colordiffuse>D0000000</colordiffuse>
                    <hitrect x="-10000" y="-10000" w="0" h="0"/>
                </control>
                <!-- Restore the original shaded texture over the translucent black base. -->
                <control type="image">
                    <visible>![Skin.HasSetting(centermainmenu) + ControlGroup(90020).HasFocus]</visible>
                    <left>-30</left><top>0</top><width>1980</width><height>590</height>
                    <texture border="5">RecentAddedBack.png</texture>
                    <hitrect x="-10000" y="-10000" w="0" h="0"/>
                </control>
                <control type="image">
                    <visible>Skin.HasSetting(centermainmenu) + ControlGroup(90020).HasFocus</visible>
                    <left>-30</left><top>0</top><width>1980</width><height>665</height>
                    <texture border="5">RecentAddedBack.png</texture>
                    <hitrect x="-10000" y="-10000" w="0" h="0"/>
                </control>
                <!-- Vertical info block above poster -->
				<control type="grouplist">
					<left>25</left>          <!-- aligned with poster left -->
					<top>25</top>            <!-- above poster top (which is 60) -->
					<width>550</width>
					<height>120</height>
					<orientation>vertical</orientation>
					<itemgap>2</itemgap>

					<!-- Year -->
					<control type="label">
						<width>350</width>
						<height>24</height>
						<label>Year: $VAR[X2InfoYear]</label>
						<font>font12</font>
						<textcolor>grey2</textcolor>
						<shadowcolor>black</shadowcolor>
						<visible>!String.IsEmpty(Window(Home).Property(X2Info.Year)) | !String.IsEmpty(Container.ListItem.Year)</visible>
					<hitrect x="-10000" y="-10000" w="0" h="0"/></control>

					<!-- Genre -->
					<control type="label">
						<width>550</width>
						<height>24</height>
						<label>Genre: $VAR[X2InfoGenres]</label>
						<font>font12</font>
						<textcolor>grey2</textcolor>
						<shadowcolor>black</shadowcolor>
						<scroll>true</scroll>
						<scrollspeed>40</scrollspeed>      <!-- pixels per second; tweak to taste -->
						<scrollsuffix>   •   </scrollsuffix> <!-- optional gap between loops -->
						<visible>!String.IsEmpty(Window(Home).Property(X2Info.Genres)) | !String.IsEmpty(Container.ListItem.Genre)</visible>
					<hitrect x="-10000" y="-10000" w="0" h="0"/></control>

					<!-- Rating -->
					<control type="label">
						<width>350</width>
						<height>24</height>
						<label>Rating: $VAR[X2InfoRating]</label>
						<font>font12</font>
						<textcolor>grey2</textcolor>
						<shadowcolor>black</shadowcolor>
						<visible>!String.IsEmpty(Window(Home).Property(X2Info.Rating)) | !String.IsEmpty(Container.ListItem.Rating)</visible>
					<hitrect x="-10000" y="-10000" w="0" h="0"/></control>

					<!-- Director -->
					<control type="label">
						<width>350</width>
						<height>24</height>
						<label>Director: $VAR[X2InfoDirector]</label>
						<font>font12</font>
						<textcolor>grey2</textcolor>
						<shadowcolor>black</shadowcolor>
						<scroll>true</scroll>
						<scrollspeed>40</scrollspeed>      <!-- pixels per second; tweak to taste -->
						<scrollsuffix>   •   </scrollsuffix> <!-- optional gap between loops -->
						<visible>!String.IsEmpty(Window(Home).Property(X2Info.Director)) | !String.IsEmpty(Container.ListItem.Director)</visible>
					<hitrect x="-10000" y="-10000" w="0" h="0"/></control>
				<hitrect x="-10000" y="-10000" w="0" h="0"/></control>


                <!-- Poster on left (same style as widget posters) -->
                <control type="image">
                    <left>19</left>
                    <top>130</top>
                    <width>260</width>
                    <height>390</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$VAR[X2InfoPoster]</texture>
                    <bordertexture border="5">button-nofocus.png</bordertexture>
                    <include>TextureBorderWidgets</include>
                <hitrect x="-10000" y="-10000" w="0" h="0"/></control>

                <!-- ClearLogo (preferred over text title) -->
                <control type="image">
                    <left>610</left>
                    <top>30</top>
                    <width>700</width>
                    <height>80</height>
                    <aspectratio>keep</aspectratio>
					<align>left</align>
					<aligny>center</aligny>
                    <texture background="true">$VAR[X2InfoClearLogo]</texture>
                    <!-- Only show if we actually have a clearlogo -->
                    <visible>!String.IsEmpty(Window(Home).Property(X2Info.ClearLogo)) | !String.IsEmpty(Container.ListItem.Art(clearlogo))</visible>
                <hitrect x="-10000" y="-10000" w="0" h="0"/></control>
				<!-- Studio / Network logo -->
				<control type="image">
					<left>1620</left>
					<top>10</top>
					<width>120</width>
					<height>120</height>
					<aspectratio>keep</aspectratio>
					<!-- Coloured resource pack, then TMDb, then white resource pack. -->
					<texture background="true">$VAR[X2InfoStudioLogo]</texture>
					<!-- No resolved logo means no image or placeholder. -->
					<visible>!String.IsEmpty(Window(Home).Property(X2Info.ResolvedStudioLogo))</visible>							 
				<hitrect x="-10000" y="-10000" w="0" h="0"/></control>
				<control type="image">
					<left>1360</left>
					<top>10</top>
					<width>220</width>
					<height>120</height>
					<aspectratio>keep</aspectratio>
					<texture>trailer.gif</texture>
					<hitrect x="-10000" y="-10000" w="0" h="0"/></control>
				
                <!-- Title (fallback when no clearlogo artwork) -->
                <control type="label">
                    <left>710</left>
                    <top>30</top>
                    <width>700</width>
                    <height>80</height>
                    <label>$VAR[X2InfoTitle]</label>
                    <font>font24_title</font>
                    <textcolor>white</textcolor>
                    <shadowcolor>black</shadowcolor>
					<scroll>true</scroll>
					<scrollspeed>40</scrollspeed>      <!-- pixels per second; tweak to taste -->
					<scrollsuffix>   •   </scrollsuffix> <!-- optional gap between loops -->
                    <!-- Only show when no clearlogo is available -->
                    <visible>String.IsEmpty(Window(Home).Property(X2Info.ClearLogo)) + String.IsEmpty(Container.ListItem.Art(clearlogo))</visible>
                <hitrect x="-10000" y="-10000" w="0" h="0"/></control>

				<!-- Plot -->
				<control type="textbox">
					<left>290</left>
					<top>120</top>
					<width>1620</width>
					<height>200</height>
					<label>$VAR[X2InfoPlot]</label>
					<font>font14</font>
					<textcolor>white</textcolor>
					<shadowcolor>black</shadowcolor>
					<autoscroll delay="4000" time="2000" repeat="8000">true</autoscroll>
				<hitrect x="-10000" y="-10000" w="0" h="0"/></control>

